# VoltFlow CSMS - Environment Variables

# Backend Port
PORT=5000

# JWT Authentication Secret
JWT_SECRET=csms-super-secret-key-2026-voltflow

# Supabase Configuration (Optional - project runs on high-performance local SQLite by default)
# To connect to Supabase:
# 1. Create a project at https://supabase.com
# 2. Run the SQL in backend/supabase_schema.sql in the Supabase SQL Editor
# 3. Paste your Project URL and API Key below:
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
